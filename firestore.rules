rules_version = '2';
// 「우리 마을 이장님」 보안 규칙
// 관리자: 선생님 Google 계정
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'bohwan9606@gmail.com' && request.auth.token.email_verified == true; }
    function nowMs() { return request.time.toMillis(); }

    // 마을 저장 (아이디로 이어 하기)
    match /villages/{id} {
      allow read, write: if signedIn();
    }

    // 자랑 게시판: 새 글만 쓰기 (같은 날 같은 기기는 1번), 수정은 관리자만, 삭제는 본인 또는 관리자
    match /boast/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','img','thumb','c0','c1','c2','texts','school','year','nick','vgrade','pop','at','expireAt','hidden'])
        && request.resource.data.uid == request.auth.uid
        && id.matches('b-' + request.auth.uid + '-[0-9]{8}')
        && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() < 300000))
        && (!('thumb' in request.resource.data) || (request.resource.data.thumb is string && request.resource.data.thumb.size() < 60000))
        && request.resource.data.get('c0', 0) == 0 && request.resource.data.get('c1', 0) == 0 && request.resource.data.get('c2', 0) == 0
        && request.resource.data.texts is list && request.resource.data.texts.size() >= 1 && request.resource.data.texts.size() <= 3
        && request.resource.data.texts.hasOnly(['intro','pop50','pop100','happy','grade','museum','folk','myeong','trans','bong','fest','dino','forest','hall','gold','grad'])
        && request.resource.data.school is string && request.resource.data.school.size() <= 12
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 8
        && request.resource.data.year is int && request.resource.data.year >= 1 && request.resource.data.year <= 6
        && request.resource.data.hidden == false
        && request.resource.data.at is int && request.resource.data.at > nowMs() - 600000 && request.resource.data.at < nowMs() + 600000
        && request.resource.data.expireAt is timestamp;
      // 응원 수: 내 응원 기록을 만들거나 지우면서 숫자를 1씩만 바꿀 수 있어요
      allow update: if isAdmin() || (signedIn() && (cheerOk(id, 'c0', '0') || cheerOk(id, 'c1', '1') || cheerOk(id, 'c2', '2')));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    function cheerPath(post, k) { return /databases/$(database)/documents/cheers/$(post + '_' + request.auth.uid + '_' + k); }
    function cheerOk(post, f, k) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([f])
        && ((request.resource.data[f] == resource.data.get(f, 0) + 1 && existsAfter(cheerPath(post, k)) && !exists(cheerPath(post, k)))
         || (request.resource.data[f] == resource.data.get(f, 0) - 1 && !existsAfter(cheerPath(post, k)) && exists(cheerPath(post, k))));
    }

    // 자랑 큰 사진: 자랑을 눌렀을 때만 읽어요
    match /boastimg/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || signedIn()
        && id.matches('b-' + request.auth.uid + '-[0-9]{8}')
        && request.resource.data.keys().hasOnly(['uid','img'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.img is string && request.resource.data.img.size() < 300000;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // 응원 스티커: 내 이름으로만 누르고, 내 것만 취소
    match /cheers/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['post','kind','by','at','expireAt'])
        && request.resource.data.by == request.auth.uid
        && id == request.resource.data.post + '_' + request.auth.uid + '_' + string(request.resource.data.kind)
        && request.resource.data.kind is int && request.resource.data.kind >= 0 && request.resource.data.kind <= 2;
      allow delete: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
    }

    // 플레이 통계: 기기별 하루 한 번 / 처음 한 번 기록, 관리자만 읽기
    match /plays/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['d','at','uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.d is string && request.resource.data.d.size() == 8
        && id == request.resource.data.d + '_' + request.auth.uid;
      allow read: if isAdmin();
    }
    match /devices/{id} {
      allow create: if signedIn() && id == request.auth.uid && request.resource.data.keys().hasOnly(['at']);
      allow read: if isAdmin();
    }

    // 선생님께 말하기: 누구나 보내고, 관리자만 읽기
    match /feedback/{id} {
      allow create: if signedIn();
      allow read, delete: if isAdmin();
    }
  }
}
